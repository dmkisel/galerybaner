# Параметры docker compose. Скопируйте в .env и поменяйте под себя.

POSTGRES_DB=galerybaner
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST_PORT=5433

APP_PORT=8501

# Кэш скачанных картинок, часы
CACHE_TTL_HOURS=24

# Разрешать ссылки на локальные адреса (внутренний CDN).
# Поставьте false, если сервис будет доступен из интернета.
IMAGES_ALLOW_PRIVATE_HOSTS=true

# Каталог: сколько карточек на странице и в ряд
GALLERY_PAGE_SIZE=12
GALLERY_COLUMNS=4

# Если в пароле есть спецсимволы, задайте строку целиком:
# DATABASE_URL=postgresql+psycopg://app:p%40ss@db:5432/galerybaner
